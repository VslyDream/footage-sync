{
  "manifestVersion": 5,
  "id": "com.vsly.footage-sync",
  "name": "Footage Sync",
  "version": "0.1.0",
  "main": "index.html",
  "host": { "app": "premierepro", "minVersion": "25.6.0" },
  "entrypoints": [{
    "type": "panel",
    "id": "footageSync",
    "label": { "default": "Footage Sync" },
    "minimumSize": { "width": 40, "height": 48 },
    "maximumSize": { "width": 2000, "height": 2000 },
    "preferredDockedSize": { "width": 50, "height": 250 },
    "preferredFloatingSize": { "width": 50, "height": 250 }
  }],
  "requiredPermissions": { "localFileSystem": "fullAccess" }
}
